# Database connection (Postgres 16). The staging compose provides this.
DATABASE_URL=postgresql://flare:flare@localhost:5432/flare?schema=public

# Public base URL of the app. Used to decide whether session cookies
# carry the Secure flag when the app runs behind a TLS-terminating proxy.
APP_URL=http://localhost:3000

# Set to 1 to load a small demo dataset on first boot (staging only).
SEED_DEMO=0

# Error tracking (Sentry / GlitchTip). Leave empty to disable.
SENTRY_DSN=

# Product analytics (Umami). Leave empty to disable.
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Rate limits (requests per window). Defaults apply when unset.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_MUTATION_WINDOW_MS=60000
